dec8_part1 =>

  lm : mutate is
  lm ! ()->
    arr := io.buffered lm .Reader.instate (io.stdin.reader lm) ()->
      io.buffered lm .read_lines
        .filter !="" .map (.codepoints.as_array) .as_array

    h := arr.length;    hl := h.as_i64
    w := arr[0].length; wl := w.as_i64

    area := array2 w h x,y->arr[y][x].val.as_i32
    dot := ".".val.as_i32

    part(n) =>
      antennas := (lm.array (list (i32,i32))).type.new 128 _->nil
      antinodes := (lm.array2 bool).type.new  wl hl false
      antinode(xi,yi) =>
        x := xi.as_i64; y := yi.as_i64
        if 0 <= x < wl && 0 <= y < hl && !antinodes[x,y] then
          antinodes[x,y] := true
      for xy in area.index_pairs.map (||>a,b->(a.as_i32,b.as_i32)) do
        xy ||> x,y->
          v := area[_,x,y]
          vl := v.as_i64
          if v != dot then
            a := antennas[vl]
            for axy in a do
              axy ||> ax, ay ->
                for i in 1 .. (n=1 ? 1 : max w h .as_i32) do
                  antinode  x+i*(x-ax)  y+i*(y-ay)
                  antinode ax+i*(ax-x) ay+i*(ay-y)

            antennas[vl] := (xy : a)
      antinodes.as_array.filter id .count

    say (part 1)
    say (part 2)
