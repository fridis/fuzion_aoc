dec2_part1 is

  lm : mutate is
  input := lm ! ()->io.buffered lm .Reader.instate (io.stdin.reader lm) ()->
    io.buffered lm .read_lines.filter !=""

  data := input.map (s -> (s.split " ").map (.parse_i32.or_panic))

  mono(s)  => s.map_pairs (<=)
               .map_pairs (=) ∀ id
  diffs(s) => s.map_pairs a,b->(|a-b|) ∀ ∈(1..3)

  part1 => data.filter mono
               .filter diffs
               .count

  say part1
