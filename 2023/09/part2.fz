dec9_part2 is

  lm : mutate is
  ls := lm ! ()->(io.buffered lm .Reader.instate (io.stdin.reader lm) ()->
    io.buffered lm .read_lines)

  # parse input into sequence of sequence of i64
  seqs := ls.map s->(s.split.map (.parse_i64.or_panic)).as_array

  # find new first and last elements to extend given sequence at both ends
  #
  extend(sq Sequence i64) =>
    if sq ∀ =0 then
      (0,0)                                               # 0..0 is easy, just add 0 on both ends
    else
      di := extend (sq.map_pairs a,b->b-a).as_array       # extend diffs
      (sq.first.or_panic - di.0, sq.last.or_panic + di.1) # use diffs to determine first + last

  ex := (seqs.map (s -> extend s)).as_array
  part1 => (ex.map (.values.1)).fold i64.type.sum
  part2 => (ex.map (.values.0)).fold i64.type.sum

  say "part1 $part1 part2 $part2"
