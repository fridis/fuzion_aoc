dec9_part1 is

  lm : mutate is
  ls := lm ! ()->io.buffered lm .Reader.instate (io.stdin.reader lm) ()->
    io.buffered lm .read_lines.or_panic

  # parse input into sequence of sequence of i64
  seqs := ls.map s->(s.split.map (.parse_i64.or_panic)).as_array

  # extend given sequence by one element
  #
  extend(sq Sequence i64) =>
    if sq ∀ =0 then                                       # 0..0 is easy, just add 0
      0
    else
      di := extend (sq.map_pairs a,b->b-a).as_array       # extend diffs
      sq.last.or_panic + di                               # use diffs to add  last

  ex := seqs.map (s -> extend s)
  part1 => ex.fold i64.type.sum

  say "part1 $part1"
