dec16_part1 is

  lm : mutate is
  input := lm ! ()->io.buffered lm .Reader.instate (io.stdin.reader lm) ()->
    io.buffered lm
      .read_lines
      .filter !=""
      .map (.codepoints)
  area := array2 String _ input.count input[0].count i,j->input[i][j]
  xs => area.indices1
  ys => area.indices0

  r => {0}; l => {1}; u => {2}; d => {3}
  part1 =>
    lm ! ()->
      visited := (lm.array i32).type.new area.base.length.as_i64 _->0
      ix(x,y) => y+x*area.length1.as_i32
      trace(x,y,w i32) unit =>
        if ((x.as_i64 ∈ xs) && (y.as_i64 ∈ ys) &&
            (visited[ix x y .as_i64] & (1 << w)) = 0) then
          visited[ix x y .as_i64] := visited[ix x y .as_i64] | (1 << w)
          c := area[_,y,x]
          if (["\\|", "/|" , "xx"  , ".|" ][w].find c).exists then trace x   y+1 d
          if (["/|" , "\\|", ".|"  , "xx" ][w].find c).exists then trace x   y-1 u
          if (["xx" , ".-" , "\\-" , "/-" ][w].find c).exists then trace x-1 y   l
          if ([".-" , "xx" , "/-"  , "\\-"][w].find c).exists then trace x+1 y   r
      trace 0 0 r
      (visited.as_array.filter !=0).count

  say "part1 $part1"
